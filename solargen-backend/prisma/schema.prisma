generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
}

model Installation {
  id             Int       @id @default(autoincrement())
  name           String
  latitude       Float
  longitude      Float
  sites          Site[]
  
  @@map("installation")
}

model Site {
  id                String        @id
  kwp               Float
  panel_count       Int
  panel_model       String
  inverters         Json
  installation_id   Int
  installation      Installation  @relation(fields: [installation_id], references: [id])
  predictions       Prediction[]

  @@map("sites")
}

model Prediction {
  id               Int      @id @default(autoincrement())
  site_id          String
  timestamp        String
  capacity_factor  Float
  solar_generation Float
  fetched_at       DateTime
  site             Site     @relation(fields: [site_id], references: [id])

  @@unique([site_id, timestamp])
  @@index([site_id, capacity_factor])
  @@index([timestamp])
  @@index([site_id, timestamp])
  @@map("predictions")
}

model Weather {
  id                   Int      @id @default(autoincrement())
  timestamp            String @unique
  temperature          Float
  relative_humidity    Float
  cloud_cover          Float
  shortwave_radiation  Float
  diffuse_radiation    Float
  fetched_at           DateTime

  @@map("weather")
}

model ModelInfo {
  id          Int      @id @default(autoincrement())
  model       String
  r2          Float
  mae         Float
  train_start String
  train_end   String
  features    Json
  sites_count Int
  fetched_at  DateTime

  @@map("model_info")
}