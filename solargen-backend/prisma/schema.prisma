generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Site {
  id             String       @id
  kwp            Float
  panel_count    Float?
  panel_model    String?
  inverter_model String?
  predictions    Prediction[]

  @@map("sites")
}

model Prediction {
  id            Int      @id @default(autoincrement())
  site_id       String
  timestamp     DateTime
  efficiency    Float
  production_kw Float
  fetched_at    DateTime
  site          Site     @relation(fields: [site_id], references: [id])

  @@unique([site_id, timestamp])
  @@map("predictions")
}

model Weather {
  id                    Int      @id @default(autoincrement())
  timestamp             DateTime
  apparent_temperature  Float
  relative_humidity     Float
  dew_point_temperature Float
  shortwave_radiation   Float
  fetched_at            DateTime
 
  @@map("weather")
}

model ModelInfo {
  id          Int      @id @default(autoincrement())
  model       String
  r2          Float
  mae         Float
  train_end   String
  features    Json
  hyperparams Json
  sites_count Int
  fetched_at  DateTime

  @@map("model_info")
}